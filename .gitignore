# macOS
.DS_Store

# Local machine-specific configs
*/local/local.zsh
local/

# Vim swap files
*.swp
*.swo
*~

# Secrets (paranoid mode)
**/credentials*
**/secrets*
*.key
*.pem

# Claude local files (also in the global ignore; committed so every clone is covered)
*.local.md
.claude/settings.local.json
vault.local.mk

# Stow test files
test-*/
